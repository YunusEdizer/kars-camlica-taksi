{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "camlicataksikars.com"
        }
      ],
      "destination": "https://www.camlicataksikars.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "camlicataksikars.com"
        }
      ],
      "destination": "https://www.camlicataksikars.com/:path*",
      "permanent": true
    },
    {
      "source": "/taksi",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/general-1",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/taxi",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(favicon.svg|favicon.ico|favicon-48.png|favicon-96.png|favicon-192.png|og.png|icon-512.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(foto|font)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
